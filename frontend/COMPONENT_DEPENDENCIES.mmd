graph TB
    subgraph "Component Dependencies"
        subgraph "Root Component"
            App["App<br/>imports:<br/>RouterOutlet"]
        end

        subgraph "Feature Components"
            Dashboard["Dashboard<br/>imports:<br/>RouterLink<br/>DatePipe<br/>MatTableModule<br/>MatSortModule<br/>Loader<br/>MetricsGrid<br/>Footer"]
            
            IngestionWizard["IngestionWizard<br/>imports:<br/>ReactiveFormsModule<br/>RouterLink"]
            
            DatasetExplorer["DatasetExplorer<br/>imports:<br/>RouterLink"]
        end

        subgraph "Layout Components"
            Footer["Footer<br/>imports:<br/>SupportBtn"]
            
            SupportBtn["SupportBtn<br/>Uses:<br/>SupportMailService"]
            
            Loader["Loader<br/>Loads:<br/>animal-facts.json<br/>Signals:<br/>wakeUpCountdown<br/>facts<br/>currentIndex"]
            
            MetricsGrid["MetricsGrid<br/>Sub-component<br/>of Dashboard<br/>Receives:<br/>metrics data"]
        end

        subgraph "Shared Services"
            MetadataApiService["MetadataApiService<br/>@Service<br/><br/>Provides:<br/>datasetsResource<br/>failedDatasetsResource<br/>datasetDetailsResource<br/>metricsCountResource<br/><br/>Methods:<br/>uploadDataset<br/>selectDataset"]
            
            SupportMailService["SupportMailService<br/>@Service<br/><br/>Methods:<br/>getEmail<br/>handleContact"]
        end

        subgraph "Angular Material Modules"
            MatTable["MatTableModule<br/>MatSortModule"]
            MatCDK["@angular/cdk<br/>Signals<br/>httpResource"]
            ReactiveFormsModule["ReactiveFormsModule<br/>FormBuilder"]
            CommonModule["CommonModule<br/>DatePipe<br/>RouterModule"]
        end

        subgraph "Data & Config"
            MetadataModel["metadata.model.ts<br/>DatasetRecord<br/>IngestionPayload<br/>IngestionStatus<br/>MetadataFormat"]
            
            Environment["environment.ts<br/>environment.development.ts<br/><br/>Config:<br/>apiUrl"]
            
            AnimalFactsData["animal-facts.json<br/>AnimalFact[]"]
        end

        subgraph "External Libraries"
            Angular["Angular 22 Core<br/>@angular/core<br/>@angular/router<br/>@angular/common"]
            
            AngularMaterial["Angular Material 22<br/>@angular/material"]
            
            RxJS["RxJS 7.8<br/>Observable<br/>HttpEvent"]
            
            TypeScript["TypeScript 6.0<br/>Strict Mode"]
        end

        subgraph "HTTP & Backend"
            HttpClient["HttpClient<br/>@angular/common/http"]
            BackendAPI["Backend API<br/>GET /datasets<br/>GET /datasets/:id<br/>POST /datasets/upload<br/>GET /metrics<br/>GET /metrics/failed-validations"]
        end
    end

