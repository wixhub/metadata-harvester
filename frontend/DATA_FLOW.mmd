    style SupportMailService fill:#E74C3C,stroke:#A93226,color:#fff
    style HttpClient fill:#3498DB,stroke:#1F5A96,color:#fff
    style ResourceDeclaration fill:#3498DB,stroke:#1F5A96,color:#fff
    style BackendAPI fill:#27AE60,stroke:#1A5E3F,color:#fff,stroke-width:2px
