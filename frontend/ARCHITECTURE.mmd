graph TB
    subgraph "Application Root"
        App["<b>App</b><br/>selector: app-root<br/>RouterOutlet"]
    end

    subgraph "Routing Configuration"
        Router["<b>Routes</b><br/>Path: '' → Dashboard<br/>Path: 'ingest' → IngestionWizard<br/>Path: 'explorer' → DatasetExplorer<br/>Path: '**' → redirect to ''"]
    end

    subgraph "Layout Components"
        Footer["<b>Footer</b><br/>selector: app-footer"]
        SupportBtn["<b>SupportBtn</b><br/>selector: app-support-btn"]
        Loader["<b>Loader</b><br/>selector: app-loader<br/>wakeUpCountdown: input<br/>facts: signal<br/>currentIndex: signal"]
        
        Footer -->|imports| SupportBtn
    end

    subgraph "Feature Modules"
        Dashboard["<b>Dashboard</b><br/>Route: ''<br/>- displayedColumns<br/>- dataSource: MatTableDataSource<br/>- datasets: signal<br/>- failedDatasets: signal"]
        
        IngestionWizard["<b>IngestionWizard</b><br/>Route: 'ingest'<br/>- form: FormGroup<br/>- uploading: signal<br/>- uploadProgress: signal<br/>- selectedFile: signal<br/>- errorMessage: signal"]
        
        DatasetExplorer["<b>DatasetExplorer</b><br/>Route: 'explorer'<br/>- datasets: signal"]
        
        MetricsGrid["<b>MetricsGrid</b><br/>selector: app-metrics-grid<br/>Component: Sub-component<br/>of Dashboard"]
        
        Dashboard -->|imports| MetricsGrid
    end

    subgraph "Core Services"
        MetadataApiService["<b>MetadataApiService</b><br/>@Service<br/>- datasetsResource: httpResource<br/>- failedDatasetsResource: httpResource<br/>- datasetDetailsResource: httpResource<br/>- selectedDatasetId: signal"]
        
        SupportMailService["<b>SupportMailService</b><br/>@Service<br/>- user: string<br/>- domain: string<br/>- getEmail(): string<br/>- handleContact(): Promise<boolean>"]
    end

    subgraph "Data Models & Types"
        Metadata["<b>metadata.model.ts</b><br/>Types:<br/>- MetadataFormat<br/>- IngestionStatus<br/>- CardType<br/><br/>Interfaces:<br/>- DatasetRecord<br/>- IngestionPayload<br/>- RestPage<T>"]
        
        AnimalFacts["<b>Animal Facts</b><br/>public/data/animal-facts.json<br/>Type: AnimalFact[]"]
    end

    subgraph "HTTP & External"
        HttpClient["<b>HttpClient</b><br/>Angular Common HTTP"]
        Environment["<b>Environment Config</b><br/>environment.apiUrl<br/>environment.development"]
    end

    subgraph "Angular Material Components"
        MatTable["MatTable, MatSort<br/>MatTableModule, MatSortModule"]
        MatForms["Reactive Forms<br/>FormBuilder, ReactiveFormsModule"]
        MatCDK["Angular CDK<br/>Signals, Reactive Utilities"]
    end

